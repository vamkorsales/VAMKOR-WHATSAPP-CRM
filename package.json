{
  "name": "vamkor-whatsapp-crm",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "install:all": "npm install --workspaces --include=dev",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run start --workspace=apps/frontend",
    "dev:gateway": "npm run start --workspace=apps/whatsapp-gateway",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:gateway\""
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
